# ---------------------------------------------------------------
# Copy this file to .env and fill in your own values:
#     cp .env.example .env
# Never commit the real .env.
# ---------------------------------------------------------------

# Port the API listens on
PORT=5000

# development | production
NODE_ENV=development

# MongoDB Atlas connection string.
# Atlas -> Cluster -> Connect -> Drivers -> copy the SRV string,
# then replace <username> and <password> with your database user.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# The database to use inside that cluster
DB_NAME=kenzy

# Secret used to sign JWTs. Use a long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_secret

# Token lifetime: 7d, 24h, 30m ...
JWT_EXPIRES_IN=7d

# CORS: comma-separated list of allowed frontend origins,
# e.g. http://localhost:5173,http://localhost:3000
# Leave empty to allow any origin (development only).
CLIENT_URL=

# Maximum accepted image upload size, in megabytes
MAX_UPLOAD_SIZE_MB=5
